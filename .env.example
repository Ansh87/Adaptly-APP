# SATGene — Firebase environment variables
# Copy this file to ".env" (which is gitignored) for local development, and add
# these same variables in Netlify (Site settings → Environment variables).
#
# Get these values from: Firebase console → Project settings → General →
# "Your apps" → SDK setup and configuration → Config.
#
# NOTE: these are NOT secrets. Firebase web config is safe to expose in the
# browser; security is enforced by Firestore rules and enabled sign-in methods.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
