rules_version = '2';

// SATGene — Firestore Security Rules
// Each user can read and write ONLY their own document at users/{uid}.
// This is what enforces per-user data isolation (the client-side equivalent
// of the requireAuth middleware used on the Railway/CollegeGene backend).
//
// Paste these into: Firebase console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // A signed-in user may read, create, update, and delete ONLY their own document.
      // 'write' already covers create/update/delete; listed explicitly for clarity so
      // account deletion (which deletes users/{uid}) is obviously permitted.
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
