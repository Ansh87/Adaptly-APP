rules_version = '2';

// SATGene — Firestore Security Rules
// Each user can read and write ONLY their own document at users/{uid}.
// This is what enforces per-user data isolation (the client-side equivalent
// of the requireAuth middleware used on the Railway/CollegeGene backend).
//
// Paste these into: Firebase console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
